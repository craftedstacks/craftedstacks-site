{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "craftedstacks-site",
  "compatibility_date": "2026-08-19",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "craftedstacks.net",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./public",
    "not_found_handling": "404-page"
  }
}
